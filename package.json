{
  "name": "content-library",
  "private": true,
  "type": "module",
  "description": "Content library run by an Elfo board: HTML → PNG/MP4 rendering and optional AI image and voice scripts.",
  "scripts": {
    "render:images": "node scripts/render-images.mjs",
    "render:video": "node scripts/render-video.mjs",
    "image": "node scripts/generate-image.mjs",
    "voice": "node scripts/narrate.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "playwright-core": "1.65.0"
  },
  "engines": { "node": ">=20" }
}
